{
  "name": "unstash",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://unstash-open.vercel.app",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:worker": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "test": "npm run build:worker && npm run test:edge && node --test tests/*.test.mjs",
    "test:edge": "deno test --config supabase/functions/deno.json supabase/functions/security-audit-orders/validation.test.ts",
    "typecheck": "tsc --noEmit && npm run typecheck:edge",
    "typecheck:edge": "deno check --config supabase/functions/deno.json supabase/functions/security-audit-orders/index.ts supabase/functions/security-audit-orders/validation.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next && npm run lint:edge",
    "lint:edge": "deno lint --config supabase/functions/deno.json supabase/functions/security-audit-orders/*.ts",
    "package:extension": "scripts/package-extension.sh"
  },
  "dependencies": {
    "@polar-sh/sdk": "^0.49.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.32",
    "deno": "2.9.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "type": "module",
  "description": "Local-first queue for saved posts and links"
}
